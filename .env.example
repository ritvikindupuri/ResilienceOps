# Copy to .env and fill in. Never commit .env.
# docker compose interpolates this file automatically from the project directory.

# --- Required for docker compose Grafana (no default password; compose fails if unset) ---
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=

# --- Optional local secrets / cloud ---
# Anthropic key for in-cluster Red/Blue agents (orchestrator.py / agent-sandbox).
ANTHROPIC_API_KEY=
# Postgres password used by order-service + postgres. Compose default: sre_password
POSTGRES_PASSWORD=
# Required before python deploy_remote.py / SSM helpers (no default).
EC2_INSTANCE_ID=
# Alias accepted by agents.config.require_ec2_instance_id()
SRE_EC2_INSTANCE_ID=
AWS_REGION=us-east-1
# Terraform ingress CIDR is NOT an env var. Copy terraform/terraform.tfvars.example
# to terraform/terraform.tfvars and set allowed_cidr to YOUR /32. 0.0.0.0/0 is rejected.

# --- Service URLs (host-side agents and scripts) ---
API_GATEWAY_URL=http://localhost:8000
ORDER_SERVICE_URL=http://localhost:8001
PAYMENT_SERVICE_URL=http://localhost:8002
# Host-side Prometheus (compose publishes 127.0.0.1:9090).
# The incident-bridge container uses BRIDGE_PROMETHEUS_URL or http://prometheus:9090.
PROMETHEUS_URL=http://localhost:9090
BRIDGE_PROMETHEUS_URL=http://prometheus:9090
LOGS_DIR=logs

# --- AI Incident Diagnosis Grok Bot (import https://x.ai/bot/feQpDSeSki7HVgkDCBUaY) ---
# Copy URL, key, and header format from the bot routine panel. Empty URL = drop locally.
GROK_WEBHOOK_URL=
GROK_WEBHOOK_KEY=
GROK_WEBHOOK_AUTH_HEADER=Authorization
# Default Bearer. Set empty to send the raw key as the header value.
GROK_WEBHOOK_AUTH_SCHEME=Bearer

# --- Incident-bridge tunables (defaults match services/incident-bridge/settings.py) ---
AGENT_ACTIVITY_LOG=logs/agent_activity.jsonl
EVIDENCE_WINDOW_SECONDS=600
PAYLOAD_MAX_BYTES=102400
DEDUPE_TTL_SECONDS=300
WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_MAX_RETRIES=3
LOG_TAIL_LINES=40
K8S_EVIDENCE_ENABLED=true

# --- SRE SLO (agents/config.py and dashboards/alerts.yml) ---
SLO_MAX_P99_LATENCY_MS=1200.0
SLO_MAX_ERROR_RATE_PERCENT=2.0

# --- In-cluster model IDs (agents/config.py). Override only if you change providers. ---
MODEL_fault_STRATEGIST=claude-sonnet-4-6
MODEL_INFRA_DISRUPTOR=claude-sonnet-4-6
MODEL_NETWORK_ADVERSARY=claude-haiku-4-5-20251001
MODEL_INCIDENT_MONITOR=claude-haiku-4-5-20251001
MODEL_DIAGNOSTIC_RCA=claude-sonnet-4-6
MODEL_AUTO_REMEDIATOR=claude-sonnet-4-6
MODEL_POST_MORTEM=claude-sonnet-4-6
DEFAULT_MODEL=claude-sonnet-4-6
AI_PROVIDER=anthropic
# Unused by default; kept so arena_runner imports succeed.
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- CloudWatch log groups (agents/config.py) ---
CW_LOG_GROUP_ATTACKER=/sre/autonomous-agent-audit
CW_LOG_GROUP_DEFENDER=/sre/autonomous-agent-audit
CW_LOG_GROUP_INCIDENTS=/sre/autonomous-agent-incidents

# --- Host-side service URLs (agents/scripts on the laptop). Compose overrides these
# inside containers (redis/postgres/api-gw hostnames on the compose network). ---
# Structured logger also reads GATEWAY_URL as a fallback for API_GATEWAY_URL.
GATEWAY_URL=http://localhost:8000
# Compose interpolates RPS_TARGET / CONCURRENCY into traffic-generator (defaults 20 / 8).
# traffic-generator/load_generator.py itself defaults to 25 / 10 if those env vars are unset.
RPS_TARGET=20
CONCURRENCY=8
REDIS_HOST=localhost
REDIS_PORT=6379
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=sre_user
POSTGRES_DB=orders_db
