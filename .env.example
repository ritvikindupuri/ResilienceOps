# Anthropic Claude API Key (set locally; never commit the real value)
ANTHROPIC_API_KEY=

# Target EC2 instance for SSM deploy/helper scripts (required; no default)
EC2_INSTANCE_ID=
AWS_REGION=us-east-1
# Terraform ingress CIDR lives in terraform/terraform.tfvars (allowed_cidr).
# Copy terraform/terraform.tfvars.example and set YOUR /32. 0.0.0.0/0 is rejected.

# Target Microservice Endpoints
API_GATEWAY_URL=http://localhost:8000
ORDER_SERVICE_URL=http://localhost:8001
PAYMENT_SERVICE_URL=http://localhost:8002

# Observability (Prometheus & Grafana). Required for docker compose (no default Grafana password).
PROMETHEUS_URL=http://localhost:9090
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=

# Postgres (order-service). Compose defaults to sre_password if unset.
POSTGRES_PASSWORD=

# Optional CloudWatch log groups
CW_LOG_GROUP_ATTACKER=/sre/autonomous-agent-audit
CW_LOG_GROUP_DEFENDER=/sre/autonomous-agent-audit
CW_LOG_GROUP_INCIDENTS=/sre/autonomous-agent-incidents

# SRE SLO Targets
SLO_MAX_P99_LATENCY_MS=1200.0
SLO_MAX_ERROR_RATE_PERCENT=2.0

# AI Incident Diagnosis Grok Bot webhook (import https://x.ai/bot/feQpDSeSki7HVgkDCBUaY).
# Copy URL, key, and header format from the bot's routine panel. Leave URL empty to drop locally.
GROK_WEBHOOK_URL=
GROK_WEBHOOK_KEY=
# Header name and scheme must match the panel. Scheme may be empty (raw key as the header value).
GROK_WEBHOOK_AUTH_HEADER=Authorization
GROK_WEBHOOK_AUTH_SCHEME=Bearer
