%%{init: { "theme": "base", "flowchart": { "curve": "basis" } }}%%
flowchart LR
  subgraph vpc ["VPC sre-enterprise-vpc — app_workloads and data_persistence unused"]
    TF[Terraform optional AWS]
    subgraph pub ["public_ingress — one EC2 host"]
      EC2[EC2: compose + k3s on this host]
      IAM[IAM role + profile]
      SSM[SSM]
      SG[SG ingress + internal]
      TF -->|provisions| EC2
      EC2 --- IAM
      EC2 --- SSM
      EC2 --- SG

      subgraph k3s ["k3s on this host"]
        K3S[k3s]
        RED[Red Team]
        BLUE[Blue Team]
      end

      subgraph lab ["Compose lab on this host"]
        TG[Traffic]
        GW[api-gw]
        OS[order-service]
        PS[payment-service]
        RD[Redis]
        PG[PostgreSQL]
        PROM[Prometheus]
        GRAF[Grafana]
        AM[Alertmanager]
        BR[incident-bridge]
        TG -->|"requests"| GW
        GW -->|"/api/orders"| OS
        GW -->|"/api/payments"| PS
        OS -->|"POST /payments"| PS
        OS --> RD
        OS --> PG
        GW -->|"metrics"| PROM
        PROM -->|"reads"| GRAF
        PROM -->|"firing alerts"| AM
        AM -->|"webhook"| BR
        BR -.->|"PromQL"| PROM
      end
    end
  end

  subgraph grok ["Grok Bot — local or AWS"]
    BOT["AI Incident Diagnosis"]
    GH[GitHub issue]
    PING[Owner ping]
    BOT -->|"label: incident"| GH
    BOT -->|"firing critical"| PING
  end

  RED -->|"faults"| OS
  BLUE -->|"health / reset"| OS
  BLUE -->|"query"| PROM
  BR -->|"enriched JSON"| BOT
